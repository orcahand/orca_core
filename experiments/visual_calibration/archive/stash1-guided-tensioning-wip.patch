diff --git a/scripts/guided_tension.py b/scripts/guided_tension.py
new file mode 100644
index 0000000..63fd218
--- /dev/null
+++ b/scripts/guided_tension.py
@@ -0,0 +1,100 @@
+"""Guided tendon tensioning: repeat centre → range check → tension until every
+finger motor follows its joint through most of its travel.
+
+See ``orca_core/maintenance/guided_tension.py`` for the protocol.
+"""
+
+import argparse
+import sys
+import threading
+
+from orca_core.maintenance.guided_tension import (
+    HOLD_CURRENT_MA,
+    PASS_FRACTION,
+    read_last_tension,
+    run_guided_tension,
+)
+from orca_core.utils.cli import add_hand_arguments, connect_hand, create_hand_from_args, shutdown_hand
+
+_COLOURS = {"pass": "\033[92m", "partial": "\033[93m", "low": "\033[91m", "unscored": "\033[90m"}
+_live = threading.Event()
+
+
+def _bar(motor: dict) -> str:
+    fraction = motor["fraction"]
+    pct = "  -" if fraction is None else f"{100 * fraction:3.0f}"
+    return f"{_COLOURS[motor['status']]}{motor['joint']}:{pct}%\033[0m"
+
+
+def _print_progress(event: dict) -> None:
+    kind = event["event"]
+    if kind == "spread" and _live.is_set():
+        line = " ".join(_bar(m) for m in event["motors"])
+        sys.stdout.write(f"\r\033[K{event['passed']}/{event['scored']}  {line}")
+        sys.stdout.flush()
+    elif kind == "score":
+        print()
+        for m in event["motors"]:
+            print(f"  motor {m['motor']:>2}  {_bar(m)}  ({m['spread_deg']:.0f} of {m['expected_deg']} deg)")
+        print(f"Score: {event['passed']}/{event['scored']} motors ({100 * event['fraction']:.0f}%)")
+
+
+def _prompt(prompt: dict) -> str:
+    action, options = prompt["action"], prompt["options"]
+    if action == "center":
+        print(f"\n=== Round {prompt['round']} ===")
+        print("Torque is off. Put every joint in the middle of its range of motion.")
+    elif action == "range_check":
+        lo, hi = min(prompt['hold_current'].values()), max(prompt['hold_current'].values())
+        held = f"{lo:.0f} mA" if lo == hi else f"{lo:.0f}-{hi:.0f} mA"
+        print(f"Motors hold the centre at {held}. Drive every joint "
+              f"through its full range; a motor passes at {100 * min(prompt['pass_fraction'].values()):.0f}%+ of its travel.")
+        _live.set()
+    elif action == "tension":
+        print(f"Motors hold at {prompt['tension_current']:.0f} mA. Take up the slack with the "
+              "ratchet tool. Tension carefully - do not overtension.")
+    if len(options) == 1:
+        input(f"Press Enter to {options[0].lower()}... ")
+        _live.clear()
+        return options[0]
+    while True:
+        choice = input(" / ".join(f"[{i + 1}] {o}" for i, o in enumerate(options)) + ": ").strip()
+        if choice.isdigit() and 1 <= int(choice) <= len(options):
+            return options[int(choice) - 1]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    add_hand_arguments(parser, feedback_flag=False)
+    parser.add_argument("--hold-current", type=float, default=HOLD_CURRENT_MA, help=f"Range-check hold current, mA (default {HOLD_CURRENT_MA}).")
+    parser.add_argument("--tension-current", type=float, default=400, help="Tensioning hold current, mA (default 400).")
+    parser.add_argument("--pass-fraction", type=float, default=PASS_FRACTION,
+                        help="Share of a joint's travel its motor must follow to pass (default 0.7).")
+    args = parser.parse_args()
+
+    hand = create_hand_from_args(args, engage_feedback=False, engage_sensors=False)
+    last = read_last_tension(hand.config)
+    if last:
+        print(f"Last successful tension: {last.get('completed_at')}")
+    try:
+        connect_hand(hand)
+        result = run_guided_tension(
+            hand,
+            prompt_callback=_prompt,
+            progress_callback=_print_progress,
+            hold_current=args.hold_current,
+            tension_current=args.tension_current,
+            pass_fraction=args.pass_fraction,
+        )
+        print("Tensioning complete. Calibrate next." if result.completed
+              else "Finished below 100%.")
+        return 0
+    except KeyboardInterrupt:
+        print("\nGuided tensioning interrupted.")
+        return 1
+    finally:
+        shutdown_hand(hand)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_guided_tension.py b/tests/test_guided_tension.py
new file mode 100644
index 0000000..cf5607e
--- /dev/null
+++ b/tests/test_guided_tension.py
@@ -0,0 +1,106 @@
+"""Guided tensioning: spreads are scored against the travel baseline, the wrist
+is left alone, and every exit leaves the motors limp."""
+
+import math
+import threading
+
+import pytest
+
+from orca_core.maintenance.guided_tension import (
+    FINISH,
+    FINISH_ANYWAY,
+    read_last_tension,
+    run_guided_tension,
+    tension_targets,
+)
+
+
+def _drive(hand, drag):
+    """Prompt answers that drag each joint's motor by ``drag(joint)`` x its travel."""
+    spread_seen = threading.Event()
+    client = hand.motor_client
+    targets = tension_targets(hand.config)
+
+    def progress(event):
+        if event["event"] == "spread":
+            spread_seen.set()
+
+    def prompt(p):
+        if p["action"] == "range_check":
+            assert all(client._torque_enabled[t.motor_id] for t in targets)
+            for t in targets:
+                half = math.radians(t.expected_deg * drag(t.joint)) / 2
+                centre = client._pos[t.motor_id]
+                client._pos[t.motor_id] = centre + half
+                spread_seen.clear()
+                assert spread_seen.wait(5)
+                client._pos[t.motor_id] = centre - half
+            spread_seen.clear()
+            assert spread_seen.wait(5)
+        return FINISH if FINISH in p["options"] else (
+            FINISH_ANYWAY if FINISH_ANYWAY in p["options"] else p["options"][0])
+
+    return prompt, progress
+
+
+def test_wrist_is_never_a_target(connected_mock_hand):
+    assert "wrist" not in {t.joint for t in tension_targets(connected_mock_hand.config)}
+
+
+def test_partial_spread_scores_short_and_releases(connected_mock_hand):
+    hand = connected_mock_hand
+    prompt, progress = _drive(hand, lambda j: 0.8 if j == "index_mcp" else 0.4)
+    result = run_guided_tension(hand, prompt_callback=prompt, progress_callback=progress, persist=True)
+
+    by_joint = {m["joint"]: m for m in result.spreads}
+    assert by_joint["index_mcp"]["status"] == "pass"
+    assert by_joint["middle_mcp"]["status"] == "partial"
+    assert not result.completed
+    assert not any(hand.motor_client._torque_enabled.values())
+    assert read_last_tension(hand.config) is None
+
+
+def test_full_spread_completes_and_records(connected_mock_hand):
+    hand = connected_mock_hand
+    prompt, progress = _drive(hand, lambda j: 0.8)
+    result = run_guided_tension(hand, prompt_callback=prompt, progress_callback=progress, persist=True)
+
+    assert result.completed and result.rounds == 1
+    assert read_last_tension(hand.config)["spreads"]["index_mcp"] == pytest.approx(0.8, abs=0.01)
+
+
+def test_stop_during_prompt_releases(connected_mock_hand):
+    hand = connected_mock_hand
+    stop = threading.Event()
+
+    def prompt(p):
+        stop.set()
+        return p["options"][0]
+
+    with pytest.raises(InterruptedError):
+        run_guided_tension(hand, prompt_callback=prompt, should_stop=stop.is_set)
+    assert not any(hand.motor_client._torque_enabled.values())
+
+
+def test_progress_carries_over_per_hand_and_resets_from_scratch(connected_mock_hand):
+    from orca_core.maintenance.guided_tension import read_progress
+
+    hand = connected_mock_hand
+    prompt, progress = _drive(hand, lambda j: 0.8 if j == "index_mcp" else 0.2)
+    run_guided_tension(hand, prompt_callback=prompt, progress_callback=progress,
+                       persist=True, hand_key="ser-0001")
+    assert read_progress(hand.config, "ser-0001")["best"]["index_mcp"] == pytest.approx(0.8, abs=0.01)
+    assert read_progress(hand.config, "ser-0002") is None
+
+    # A resumed run keeps index_mcp passed without moving it again.
+    prompt, progress = _drive(hand, lambda j: 0.0)
+    result = run_guided_tension(hand, prompt_callback=prompt, progress_callback=progress,
+                                persist=True, hand_key="ser-0001")
+    by_joint = {m["joint"]: m for m in result.spreads}
+    assert by_joint["index_mcp"]["status"] == "pass"
+    assert by_joint["index_mcp"]["kept"] == pytest.approx(0.8, abs=0.01)
+
+    prompt, progress = _drive(hand, lambda j: 0.0)
+    result = run_guided_tension(hand, prompt_callback=prompt, progress_callback=progress,
+                                persist=True, hand_key="ser-0001", resume=False)
+    assert {m["joint"]: m for m in result.spreads}["index_mcp"]["status"] == "low"
